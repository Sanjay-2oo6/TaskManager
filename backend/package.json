{
  "name": "task-manager-server",
  "version": "1.0.0",
  "description": "Backend for Role-Based Productivity Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "npm run test:all",
    "test:all": "echo 'Running all tests...' && node test-integration.js && node test-super-admin.js && node test-multi-tenant.js",
    "test:integration": "node test-integration.js",
    "test:admin": "node test-super-admin.js",
    "test:multitenant": "node test-multi-tenant.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:stop": "pm2 stop task-manager-api",
    "pm2:restart": "pm2 restart task-manager-api",
    "pm2:reload": "pm2 reload task-manager-api",
    "pm2:delete": "pm2 delete task-manager-api",
    "pm2:logs": "pm2 logs task-manager-api",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.504.0",
    "@aws-sdk/s3-request-presigner": "^3.504.0",
    "apicache": "^1.6.3",
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.10.0",
    "form-data": "^4.0.6",
    "helmet": "^7.1.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "password-validator": "^5.3.0",
    "sanitize-html": "^2.17.5",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}

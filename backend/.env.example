# Task Manager Backend — Environment Variables
# Copy this file to .env and fill in all values before starting the server.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development   # Set to "production" on Render/Heroku

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (replace placeholders)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Master admin account protection (username of the superadmin account)
MASTER_ADMIN_USERNAME=your_master_admin_username

# ─── AWS S3 (File Storage) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your_s3_bucket_name

# ─── Firebase Cloud Messaging (Push Notifications) ───────────────────────────
# Paste the entire service account JSON as a single-line string
# Get it from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ─── Backend Public URL ───────────────────────────────────────────────────────
# The public URL where this server is deployed (used by the Flutter app)
# ● Local  : http://localhost:5000
# ● Render : https://<your-app-name>.onrender.com
BACKEND_URL=https://your-backend-url.onrender.com

# ─── CORS (optional) ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave unset to allow all (*).
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ========================================
# INNO TECH HUB - Task Manager
# Root .gitignore
# ========================================

# Environment Variables
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS Files
Thumbs.db
Desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary Files
tmp/
temp/
*.tmp

# Backup Files
*.bak
backups/

# Documentation Build Files
docs/.build/

# Test Coverage
coverage/
.nyc_output/

# ========================================
# Backend (Node.js) - Already handled in backend/.gitignore
# ========================================
backend/node_modules/
backend/.env
backend/logs/
backend/uploads/

# ========================================
# Frontend (Flutter) - Already handled in frontend/.gitignore
# ========================================
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/build/
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/.pub-cache/
frontend/.pub/

# ========================================
# Legacy Folders (To be removed after migration)
# ========================================
Task-manager-main/
